# Variáveis de ambiente (configure na Vercel: Project → Settings → Environment Variables)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Recomendado: código exigido no primeiro cadastro do Face ID
CODIGO_INICIAL=
# Avisos no celular (opcional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Senha do atalho do iPhone (Apple Pay) (opcional)
ATALHO_CHAVE=
# Opcionais
SITE_URL=
APP_PREFIXO=financeiro
